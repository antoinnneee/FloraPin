---
import PhoneNav from './PhoneNav.astro';
import { APP_VERSION } from '../config';

// Trois écrans de l'app reconstitués en HTML/CSS (pas des captures) : ils suivent
// la structure et les couleurs réelles de app/.../map, /detail et /feed. Chaque
// cadre garde une légère inclinaison, comme des photos posées sur une table.

// Regroupement de la carte : la marguerite ambrée du palier 10–49
// (app/.../map/MapClustering.kt, cf. asset/generated/map_cluster_medium.png).
const clusterPetals = Array.from({ length: 12 }, (_, i) => i * 30);
---

<section id="apercu" class="screens">
  <div class="container">
    <div class="section-header reveal">
      <span class="eyebrow">Aperçu</span>
      <h2>L'app <em>en un coup d'œil</em></h2>
      <p class="note">
        Interface de la bêta {APP_VERSION} — les fleurs affichées sont des exemples.
      </p>
    </div>

    <div class="gallery">
      <!-- ————— Carte ————— -->
      <figure class="phone reveal" style="--tilt:-2deg">
        <div class="frame">
          <div class="screen" aria-hidden="true">
            <div class="statusbar"><span>9:41</span><span>▮▮▮</span></div>
            <div class="topbar"><span class="title">Carte</span></div>

            <div class="chips">
              <span class="chip on">Tout</span>
              <span class="chip">7 jours</span>
              <span class="chip">30 jours</span>
              <span class="chip">🗺️ Rues</span>
            </div>

            <div class="map">
              <svg class="map-bg" viewBox="0 0 200 340" preserveAspectRatio="xMidYMid slice">
                <rect width="200" height="340" fill="#eef2e8" />
                <path d="M-10 40 L70 10 L130 60 L90 130 L10 110 Z" fill="#dfebd2" />
                <path d="M120 200 L210 170 L215 260 L140 280 Z" fill="#dfebd2" />
                <path d="M-10 250 C 40 240, 60 300, 120 290 S 190 320, 215 300"
                      stroke="#c6dde9" stroke-width="9" fill="none" stroke-linecap="round" />
                <g stroke="#ffffff" stroke-width="5" stroke-linecap="round">
                  <path d="M-10 150 L215 130" />
                  <path d="M60 -10 L80 350" />
                  <path d="M150 -10 L140 350" />
                </g>
                <g stroke="#f7f9f5" stroke-width="2.5" stroke-linecap="round">
                  <path d="M-10 220 L215 205" />
                  <path d="M-10 75 L215 60" />
                  <path d="M110 -10 L118 350" />
                </g>
              </svg>

              <span class="mk" style="top:31%; left:26%">🌸</span>
              <span class="mk" style="top:73%; left:34%">🌺</span>

              <!-- À fort zoom, l'app remplace l'emoji par la vignette de la photo. -->
              <img class="mk-photo" style="top:47%; left:68%" src="/img/flower-poppy.webp"
                   alt="" width="480" height="480" loading="lazy" decoding="async" />

              <span class="cluster" style="top:22%; left:62%">
                <svg viewBox="0 0 44 44">
                  {clusterPetals.map((a) => (
                    <ellipse cx="22" cy="8.5" rx="3.6" ry="6.4" fill="#dda03c"
                             stroke="#ffffff" stroke-width="1" transform={`rotate(${a} 22 22)`} />
                  ))}
                  <circle cx="22" cy="22" r="9.6" fill="#7a5324" stroke="#ffffff" stroke-width="1.4" />
                  <text x="22" y="25.4" text-anchor="middle" font-size="10" font-weight="700" fill="#ffffff">12</text>
                </svg>
              </span>

              <span class="fab">📍</span>
            </div>
          </div>
          <PhoneNav active="home" />
        </div>
        <figcaption>Carte &amp; regroupements</figcaption>
      </figure>

      <!-- ————— Détail ————— -->
      <figure class="phone reveal" style="--tilt:1.4deg; transition-delay:0.08s">
        <div class="frame">
          <div class="screen" aria-hidden="true">
            <div class="statusbar"><span>9:41</span><span>▮▮▮</span></div>
            <div class="topbar">
              <span class="back">←</span>
              <span class="title">Détail</span>
              <span class="acts">🗒 ⤴ ⋯</span>
            </div>

            <div class="detail">
              <!-- Galerie asymétrique : la couverture domine, les autres photos
                   s'empilent à droite sous un compteur cliquable. -->
              <div class="photostrip">
                <img class="g-main" src="/img/flower-detail.webp" alt="" width="480" height="640" loading="lazy" decoding="async" />
                <img class="g-side" src="/img/flower-anemone.webp" alt="" width="480" height="480" loading="lazy" decoding="async" />
                <span class="g-more"><b>📷</b>2 photos</span>
              </div>

              <div class="idline">
                <span class="sp-name">Pétunias</span>
                <span class="sp-edit">✎</span>
                <span class="hearts">❤️ 5</span>
              </div>

              <div class="tabs">
                <span class="tab on">Aperçu</span>
                <span class="tab">Notes</span>
                <span class="tab">Discussion</span>
              </div>

              <p class="sec-title">Lieu d'observation</p>
              <div class="place">
                <div class="minimap">
                  <svg viewBox="0 0 200 90" preserveAspectRatio="none">
                    <rect width="200" height="90" fill="#e3ecdb" />
                    <g stroke="#ffffff" stroke-width="7" fill="none" stroke-linecap="round">
                      <path d="M-5 34 C 40 22, 70 50, 205 30" />
                      <path d="M62 -5 L74 95" />
                    </g>
                    <g stroke="#c9d8bd" stroke-width="2.5" fill="none">
                      <path d="M-5 66 C 60 52, 110 78, 205 58" />
                    </g>
                  </svg>
                  <span class="minimap-pin">📍</span>
                </div>
                <div class="place-info">
                  <p class="place-name">Cendras</p>
                  <p class="place-coords">44,1550, 4,0537</p>
                  <p class="place-link">Ouvrir la carte ›</p>
                </div>
              </div>

              <div class="inforow">
                <span class="ico">🌼</span>
                <span class="lbl">Espèce</span>
                <span class="val">Pétunias</span>
                <span class="chev">›</span>
              </div>
              <div class="inforow">
                <span class="ico">📅</span>
                <span class="lbl">Ajoutée le</span>
                <span class="val">27 juin 2026</span>
              </div>
              <div class="inforow">
                <span class="ico">📷</span>
                <span class="lbl">Photos</span>
                <span class="val">2</span>
              </div>
            </div>
          </div>
          <PhoneNav active="home" />
        </div>
        <figcaption>Détail d'une fleur</figcaption>
      </figure>

      <!-- ————— Flux d'amis ————— -->
      <figure class="phone reveal" style="--tilt:-1deg; transition-delay:0.16s">
        <div class="frame">
          <div class="screen" aria-hidden="true">
            <div class="statusbar"><span>9:41</span><span>▮▮▮</span></div>
            <div class="topbar">
              <span class="title">Partagées</span>
              <span class="bell">🔔<i class="badge">6</i></span>
            </div>

            <div class="chips">
              <span class="chip on">Récentes</span>
              <span class="chip">Meilleures photos</span>
              <span class="chip">★ Ma sélection</span>
            </div>

            <div class="masonry">
              <article class="post">
                <div class="post-photo">
                  <img src="/img/flower-anemone.webp" alt="" width="480" height="480" loading="lazy" decoding="async" />
                  <span class="ov">🤍</span>
                  <span class="ov star">☆</span>
                </div>
                <div class="post-body">
                  <p class="by">Skaynis</p>
                  <p class="loc">📍 Bagneux</p>
                  <p class="cmt">💬 Commenter (1)</p>
                </div>
              </article>

              <article class="post">
                <div class="post-photo">
                  <img src="/img/flower-poppy.webp" alt="" width="480" height="480" loading="lazy" decoding="async" />
                  <span class="ov">🤍</span>
                  <span class="ov star">☆</span>
                </div>
                <div class="post-body">
                  <p class="by">Mandy Jouanne</p>
                  <p class="loc">📍 Bagneux</p>
                  <p class="cmt">💬 Commenter (0)</p>
                </div>
              </article>
            </div>

            <p class="feed-sep"><span>Nouveau depuis votre dernière visite</span></p>

            <div class="masonry">
              <article class="post">
                <div class="post-photo">
                  <img src="/img/flower-orchid.webp" alt="" width="480" height="480" loading="lazy" decoding="async" />
                  <span class="ov liked">❤️</span>
                  <span class="ov star">☆</span>
                  <span class="count">1 / 3</span>
                  <span class="post-caption">Epipactis hell…</span>
                </div>
                <div class="post-body">
                  <p class="by">Véronique</p>
                  <p class="loc">📍 Uzech</p>
                  <p class="cmt">💬 Commenter (0)</p>
                </div>
              </article>

              <article class="post">
                <div class="post-photo">
                  <img src="/img/flower-detail.webp" alt="" width="480" height="640" loading="lazy" decoding="async" />
                  <span class="ov">🤍</span>
                  <span class="ov star">☆</span>
                </div>
                <div class="post-body">
                  <p class="by">Véronique</p>
                  <p class="loc">📍 Yport</p>
                  <p class="cmt">💬 Commenter (0)</p>
                </div>
              </article>

              <!-- Rognées par le bas de l'écran : la mosaïque continue. -->
              <article class="post">
                <div class="post-photo">
                  <img src="/img/flower-poppy.webp" alt="" width="480" height="480" loading="lazy" decoding="async" />
                  <span class="ov liked">❤️</span>
                  <span class="ov star">☆</span>
                </div>
              </article>
              <article class="post">
                <div class="post-photo">
                  <img src="/img/flower-anemone.webp" alt="" width="480" height="480" loading="lazy" decoding="async" />
                  <span class="ov liked">❤️</span>
                  <span class="ov star">☆</span>
                </div>
              </article>
              <article class="post">
                <div class="post-photo">
                  <img src="/img/flower-detail.webp" alt="" width="480" height="640" loading="lazy" decoding="async" />
                  <span class="ov">🤍</span>
                  <span class="ov star">☆</span>
                </div>
              </article>
              <article class="post">
                <div class="post-photo">
                  <img src="/img/flower-orchid.webp" alt="" width="480" height="480" loading="lazy" decoding="async" />
                  <span class="ov">🤍</span>
                  <span class="ov star">☆</span>
                </div>
              </article>
            </div>
          </div>
          <PhoneNav active="feed" />
        </div>
        <figcaption>Le flux de vos amis</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .screens {
    padding: var(--section-py) 0;
    background: var(--tilleul);
  }

  .section-header .note {
    margin-top: 12px;
    font-size: 0.88rem;
    color: var(--texte-doux);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(22px, 4vw, 48px);
    align-items: start;
  }

  /* Conteneur de requête : c'est la largeur de la colonne qui fixe l'échelle du
     mockup (cqi ci-dessous). Le `container-type` doit vivre sur le PARENT du
     cadre — un élément ne peut pas se mesurer à lui-même. */
  .phone {
    container-type: inline-size;
    rotate: var(--tilt);
    transition:
      rotate 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.7s ease;
  }

  .phone:hover {
    rotate: 0deg;
    transform: translateY(-6px);
  }

  figcaption {
    margin-top: 18px;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--feuille);
  }

  /* Coque du téléphone. Tout son contenu est dimensionné en `em` : régler la
     taille de base ici met le mockup à l'échelle de la colonne d'un bloc. */
  .frame {
    display: flex;
    flex-direction: column;
    aspect-ratio: 9 / 19;
    background: var(--encre);
    border: 0.5em solid var(--encre);
    border-radius: 26px;
    overflow: hidden;
    box-shadow: 0 20px 48px rgba(19, 42, 29, 0.24);
    font-size: 11px; /* repli si les unités de conteneur manquent */
  }

  .frame:hover {
    box-shadow: 0 28px 60px rgba(19, 42, 29, 0.3);
  }

  @supports (font-size: 1cqi) {
    .frame { font-size: 3.7cqi; }
  }

  .screen {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
    background: #fbfdfb;
    color: #1b1c1a;
    line-height: 1.35;
  }

  .statusbar {
    display: flex;
    justify-content: space-between;
    padding: 0.35em 1em 0;
    font-size: 0.65em;
    color: #404943;
  }

  .topbar {
    display: flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.7em 0.9em;
  }

  .topbar .title {
    flex: 1;
    font-size: 1.1em;
    font-weight: 700;
  }

  .topbar .back,
  .topbar .acts,
  .topbar .bell {
    font-size: 0.9em;
    color: #404943;
  }

  .bell {
    position: relative;
  }

  .badge {
    position: absolute;
    top: -0.35em;
    right: -0.5em;
    display: grid;
    place-items: center;
    min-width: 1.25em;
    height: 1.25em;
    padding: 0 0.25em;
    border-radius: 100px;
    background: #ba1a1a;
    color: #fff;
    font-size: 0.6em;
    font-style: normal;
    font-weight: 700;
  }

  /* Puces de filtre Material */
  .chips {
    display: flex;
    gap: 0.45em;
    padding: 0 0.9em 0.7em;
    overflow: hidden;
  }

  .chip {
    flex: none;
    padding: 0.3em 0.7em;
    border: 1px solid #c0c9c0;
    border-radius: 100px;
    font-size: 0.72em;
    color: #404943;
    white-space: nowrap;
  }

  .chip.on {
    background: #d5e8dc;
    border-color: #d5e8dc;
    color: #101f18;
    font-weight: 700;
  }

  /* ————— Carte ————— */

  .map {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }

  .map-bg {
    width: 100%;
    height: 100%;
  }

  .mk {
    position: absolute;
    transform: translate(-50%, -50%);
    font-size: 1.35em;
    filter: drop-shadow(0 2px 3px rgba(0, 0, 0, 0.25));
  }

  .mk-photo {
    position: absolute;
    width: 2.6em;
    height: 2.6em;
    transform: translate(-50%, -50%);
    object-fit: cover;
    border-radius: 50%;
    border: 0.16em solid #ffffff;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.3);
  }

  .cluster {
    position: absolute;
    width: 3.4em;
    height: 3.4em;
    transform: translate(-50%, -50%);
    filter: drop-shadow(0 3px 5px rgba(0, 0, 0, 0.25));
  }

  .fab {
    position: absolute;
    right: 0.9em;
    bottom: 0.9em;
    display: grid;
    place-items: center;
    width: 3.1em;
    height: 3.1em;
    border-radius: 1em;
    background: #a8d5ba;
    font-size: 1.45em;
    box-shadow: 0 3px 8px rgba(19, 42, 29, 0.28);
  }

  /* ————— Détail ————— */

  .detail {
    flex: 1;
    overflow: hidden;
    padding: 0 0.75em 0.6em;
    display: flex;
    flex-direction: column;
    gap: 0.55em;
  }

  /* Couverture large à gauche, pile de vignettes à droite. */
  .photostrip {
    display: grid;
    grid-template-columns: 1.85fr 1fr;
    grid-template-rows: auto auto;
    gap: 0.4em;
  }

  .g-main {
    grid-row: 1 / span 2;
    width: 100%;
    height: 100%;
    max-height: 11.6em;
    object-fit: cover;
    border-radius: 0.7em;
  }

  .g-side {
    width: 100%;
    height: 5.6em;
    object-fit: cover;
    border-radius: 0.7em;
  }

  /* Tuile « n photos » : l'app y regroupe le reste de la galerie. */
  .g-more {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.15em;
    height: 5.6em;
    border-radius: 0.7em;
    background: #e4efe6;
    color: #2c5f45;
    font-size: 0.62em;
    font-weight: 700;
  }

  .g-more b {
    font-size: 1.5em;
    line-height: 1;
  }

  .idline {
    display: flex;
    align-items: center;
    gap: 0.4em;
  }

  .sp-name {
    font-family: var(--font-display);
    font-size: 1.32em;
    font-weight: 700;
    color: #2c5f45;
    line-height: 1.1;
  }

  .sp-edit {
    color: #6f9478;
    font-size: 0.85em;
  }

  .hearts {
    margin-left: auto;
    background: #f1f4ef;
    border-radius: 999px;
    padding: 0.2em 0.6em;
    font-size: 0.68em;
    font-weight: 700;
    color: #26382d;
  }

  /* Onglets segmentés : Aperçu / Notes / Discussion. */
  .tabs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    background: #f1f4ef;
    border-radius: 999px;
    padding: 0.18em;
  }

  .tab {
    text-align: center;
    font-size: 0.66em;
    padding: 0.42em 0;
    border-radius: 999px;
    color: #4d6455;
  }

  .tab.on {
    background: #cfe6d8;
    color: #1f4433;
    font-weight: 700;
  }

  .sec-title {
    font-family: var(--font-display);
    font-size: 0.92em;
    font-weight: 700;
    color: #2c5f45;
    margin: 0.15em 0 0;
  }

  .place {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 0.6em;
    align-items: center;
  }

  .minimap {
    position: relative;
    border-radius: 0.6em;
    overflow: hidden;
    height: 5em;
  }

  .minimap svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .minimap-pin {
    position: absolute;
    top: 38%;
    left: 46%;
    font-size: 0.85em;
  }

  .place-name {
    margin: 0;
    font-size: 0.86em;
    font-weight: 700;
    color: #26382d;
  }

  .place-coords {
    margin: 0.1em 0 0;
    font-size: 0.62em;
    color: #5a6c5f;
  }

  .place-link {
    margin: 0.25em 0 0;
    font-size: 0.66em;
    font-weight: 700;
    color: #2c5f45;
  }

  /* Lignes d'information : pastille ronde + libellé + valeur. */
  .inforow {
    display: flex;
    align-items: center;
    gap: 0.55em;
    border-top: 1px solid #e7ece5;
    padding-top: 0.5em;
  }

  .ico {
    display: grid;
    place-items: center;
    width: 1.9em;
    height: 1.9em;
    border-radius: 50%;
    background: #e4efe6;
    font-size: 0.66em;
  }

  .lbl {
    font-size: 0.74em;
    color: #26382d;
  }

  .val {
    margin-left: auto;
    font-size: 0.72em;
    color: #5a6c5f;
  }

  .chev {
    color: #9aa89d;
    font-size: 0.8em;
  }

  /* ————— Flux ————— */

  .feed-sep {
    display: flex;
    align-items: center;
    gap: 0.5em;
    margin: 0.5em 0.75em 0.35em;
    font-size: 0.6em;
    color: #4d6455;
    white-space: nowrap;
  }

  .feed-sep::before,
  .feed-sep::after {
    content: '';
    flex: 1;
    height: 1px;
    background: #dce5dd;
  }

  .masonry {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5em;
    padding: 0 0.75em;
  }

  .post {
    border-radius: 0.8em;
    overflow: hidden;
    background: #ffffff;
  }

  .post-photo {
    position: relative;
  }

  .post-photo img {
    width: 100%;
    height: 6.2em;
    object-fit: cover;
    display: block;
  }

  /* Réactions posées sur la photo, dans des pastilles translucides. */
  .ov {
    position: absolute;
    top: 0.35em;
    left: 50%;
    transform: translateX(-130%);
    display: grid;
    place-items: center;
    width: 1.8em;
    height: 1.8em;
    border-radius: 50%;
    background: rgba(30, 44, 34, 0.28);
    font-size: 0.62em;
  }

  .ov.star {
    transform: translateX(30%);
    color: #ffffff;
  }

  .count {
    position: absolute;
    top: 0.5em;
    right: 0.5em;
    font-size: 0.52em;
    color: #ffffff;
    background: rgba(30, 44, 34, 0.35);
    border-radius: 999px;
    padding: 0.1em 0.4em;
  }

  .post-caption {
    position: absolute;
    left: 0.5em;
    bottom: 0.4em;
    right: 0.5em;
    font-size: 0.62em;
    font-weight: 700;
    color: #ffffff;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.55);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Pied de carte lilas : la teinte qui distingue le flux d'amis. */
  .post-body {
    background: #e9e2f0;
    padding: 0.45em 0.5em 0.55em;
    text-align: center;
  }

  .post-body .by {
    margin: 0;
    font-size: 0.68em;
    font-weight: 700;
    color: #2c5f45;
  }

  .post-body .loc {
    margin: 0.2em 0 0;
    font-size: 0.6em;
    color: #26382d;
  }

  .post-body .cmt {
    margin: 0.25em 0 0;
    font-size: 0.6em;
    font-weight: 700;
    color: #2c5f45;
  }

  /* ————— Responsive ————— */

