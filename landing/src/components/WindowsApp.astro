---
import { existsSync, statSync } from 'node:fs';
import release from '../windows-release.json';

// Le manifeste est réécrit par `./gradlew :desktop:publishWindowsRelease`, qui
// dépose l'archive dans public/telechargements/ et y consigne sa version.
//
// On ne s'y fie pas seul pour proposer le lien : l'archive n'est pas versionnée,
// donc un site construit depuis une machine (ou un VPS) qui ne l'a pas reçue
// afficherait un lien mort. Le build Astro tournant là où les fichiers sont
// servis, il peut vérifier la présence réelle du fichier — et en lire la taille
// exacte plutôt que de recopier une valeur qui pourrait avoir vieilli.
const archive = new URL(`../../public/telechargements/${release.fileName}`, import.meta.url);
const present = existsSync(archive);
const disponible = release.available && present;
const poids = present ? `${Math.round(statSync(archive).size / 1024 / 1024)} Mo` : null;
const lien = `/telechargements/${release.fileName}`;

const atouts = [
  {
    titre: 'Toutes vos photos en grand',
    texte:
      "Parcourez votre herbier sur l'écran de votre ordinateur, agrandissez les vignettes, ouvrez une photo en plein écran d'un double-clic.",
  },
  {
    titre: 'Vos albums, au clavier et à la souris',
    texte:
      'Sélectionnez plusieurs photos comme dans vos dossiers habituels, rangez-les en un geste, renommez et réorganisez vos albums.',
  },
  {
    titre: 'Récupérez vos photos',
    texte:
      "Choisissez un dossier : FloraPin y dépose vos images classées par date, par espèce ou par album, avec un récapitulatif de vos observations.",
  },
  {
    titre: 'La carte et l’entraide',
    texte:
      'Revoyez vos trouvailles et celles de vos amis sur la carte, et continuez à identifier leurs fleurs depuis votre bureau.',
  },
];
---

<section id="ordinateur" class="windows">
  <div class="container">
    <div class="section-header reveal">
      <span class="eyebrow">Sur ordinateur</span>
      <h2>FloraPin sur <em>votre PC</em></h2>
      <p class="note">
        Le compagnon Windows accompagne l'application mobile : vos photos y
        arrivent toutes seules. Les photos, elles, se prennent toujours avec
        votre téléphone.
      </p>
    </div>

    <div class="grid">
      <ul class="atouts reveal">
        {atouts.map((a) => (
          <li>
            <h3>{a.titre}</h3>
            <p>{a.texte}</p>
          </li>
        ))}
      </ul>

      <div class="download reveal">
        <svg class="glyph" viewBox="0 0 48 48" width="56" height="56" aria-hidden="true">
          <rect x="4" y="9" width="40" height="26" rx="3" fill="var(--sapin)" />
          <rect x="7" y="12" width="34" height="20" rx="1.5" fill="var(--tilleul)" />
          <path d="M2 39h44l-3 4H5z" fill="var(--feuille)" />
          <g transform="translate(24 22)">
            {[0, 72, 144, 216, 288].map((a) => (
              <ellipse cx="0" cy="-5" rx="2.8" ry="4.6" fill="var(--rose)"
                       transform={`rotate(${a})`} />
            ))}
            <circle cx="0" cy="0" r="2.6" fill="var(--pollen)" />
          </g>
        </svg>

        {disponible ? (
          <>
            <a class="btn" href={lien} download>
              Télécharger pour Windows
            </a>
            <p class="meta">
              Version {release.version} · {poids}
              <br />
              Windows 10 et 11 · 64 bits
            </p>
            <p class="hint">
              Archive à décompresser, puis lancez <code>FloraPin.exe</code>.
              Rien d'autre à installer : tout est inclus.
            </p>
          </>
        ) : (
          <>
            <p class="soon">Bientôt disponible</p>
            <p class="hint">
              Le compagnon est en préparation. En attendant, retrouvez toutes
              vos fleurs dans l'application mobile.
            </p>
          </>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .windows {
    padding: var(--section-py) 0;
    background: var(--tilleul);
  }

  .grid {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: clamp(28px, 4vw, 56px);
    align-items: start;
    margin-top: 48px;
  }

  .atouts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 22px;
  }

  .atouts h3 {
    font-family: var(--font-display);
    font-size: 1.06rem;
    margin: 0 0 4px;
    color: var(--encre);
  }

  .atouts p {
    margin: 0;
    color: var(--texte-doux);
    line-height: 1.6;
  }

  /* Les puces reprennent la corolle du reste de la vitrine. */
  .atouts li {
    position: relative;
    padding-left: 26px;
  }

  .atouts li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 6px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--rose);
    box-shadow: 0 0 0 4px var(--rose-doux);
  }

  .download {
    background: var(--papier);
    border: 1px solid var(--tilleul-2);
    border-radius: var(--radius);
    padding: 32px 28px;
    text-align: center;
    position: sticky;
    top: 24px;
  }

  .glyph {
    display: block;
    margin: 0 auto 18px;
  }

  .btn {
    display: inline-block;
    background: var(--pollen);
    color: var(--encre);
    font-weight: 700;
    text-decoration: none;
    padding: 14px 26px;
    border-radius: 999px;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .btn:hover {
    background: var(--pollen-2);
    transform: translateY(-1px);
  }

  .soon {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--feuille);
    margin: 0 0 8px;
  }

  .meta {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--texte-doux);
    margin: 14px 0 0;
  }

  .hint {
    font-size: 0.88rem;
    color: var(--texte-doux);
    margin: 10px 0 0;
    line-height: 1.55;
  }

  code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--tilleul);
    padding: 1px 5px;
    border-radius: 5px;
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .download {
      position: static;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn {
      transition: none;
    }
  }
</style>
